{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iinatan.invalid/config.schema.json",
  "title": "iinatan configuration",
  "type": "object",
  "required": ["schemaVersion", "global", "dictionaries", "pendingDictionaries", "activeProfileId", "profiles"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "global": {
      "type": "object",
      "required": ["backendPath", "ffmpegPath", "logPath"],
      "properties": {
        "backendPath": { "type": "string" },
        "ffmpegPath": { "type": "string" },
        "logPath": { "type": "string" },
        "lowRamImport": { "type": "boolean" },
        "recommendedDictionaries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "pattern": "^https://" }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "dictionaries": { "type": "array", "items": { "$ref": "#/$defs/dictionary" } },
    "pendingDictionaries": { "type": "array" },
    "activeProfileId": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "migration": { "type": "object" }
  },
  "$defs": {
    "dictionary": {
      "type": "object",
      "required": ["id", "title", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" }
      }
    },
    "profile": {
      "type": "object",
      "required": ["name", "dictionaries", "lookupLanguage", "theme", "audio", "anki"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dictionaries": { "type": "array", "items": { "type": "string" } },
        "lookupLanguage": { "enum": ["ja", "en", "de", "fr", "ko", "zh"] },
        "subtitleLookupMode": { "enum": ["hover", "shift-hover"] },
        "theme": {
          "type": "object",
          "required": ["preset", "background", "foreground", "accent", "muted", "border"],
          "properties": {
            "preset": { "enum": ["dark", "light", "high-contrast"] },
            "background": { "$ref": "#/$defs/color" },
            "foreground": { "$ref": "#/$defs/color" },
            "accent": { "$ref": "#/$defs/color" },
            "muted": { "$ref": "#/$defs/color" },
            "border": { "$ref": "#/$defs/color" }
          }
        },
        "audio": { "type": "object" },
        "anki": { "type": "object" }
      }
    },
    "color": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" }
  }
}

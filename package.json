{
  "name": "iinatan",
  "version": "2.1.4",
  "private": true,
  "description": "Native cross-platform popup dictionary for mpv 0.41+",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "python3 scripts/build_plugin.py",
    "build:mpv": "node scripts/build_mpv.js && cmake --preset release && cmake --build --preset release",
    "test:mpv": "node scripts/build_mpv.js && node tests/mpv_041_runtime.test.js",
    "format:js": "prettier --write \"**/*.js\"",
    "package": "python3 scripts/build_plugin.py --package dist/iinatan.iinaplgz",
    "validate": "python3 scripts/build_plugin.py --validate",
    "validate:release": "python3 scripts/build_plugin.py --validate --require-backend",
    "test": "node scripts/run_tests.js",
    "test:group": "node scripts/run_tests.js --group",
    "test:perf": "node tests/lookup_performance.test.js",
    "perf:plugin": "node scripts/benchmark_plugin_performance.js",
    "perf:anki": "node scripts/benchmark_anki_export.js",
    "perf:youtube-subs": "node scripts/benchmark_youtube_native_subtitles.js",
    "preview:data": "node scripts/generate_popup_preview_data.js",
    "test:native-ass": "node tests/native_ass_geometry.test.js",
    "pack": "/Applications/IINA.app/Contents/MacOS/iina-plugin pack .",
    "link": "/Applications/IINA.app/Contents/MacOS/iina-plugin link .",
    "iina:pack": "/Applications/IINA.app/Contents/MacOS/iina-plugin pack .",
    "iina:link": "/Applications/IINA.app/Contents/MacOS/iina-plugin link ."
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "prettier": "^3.8.4"
  }
}

+static void update_lookup_rect(
+    ASS_IinatanLookupRect *rects, int *count, int id,
+    int x0, int y0, int x1, int y1)
+{
+    ASS_IinatanLookupRect *rect = NULL;
+    for (int i = 0; i < *count; i++) {
+        if (rects[i].id == id) {
+            rect = &rects[i];
+            break;
+        }
+    }
+    if (!rect && *count < 256) {
+        rect = &rects[(*count)++];
+        rect->id = id;
+        rect->x = x0;
+        rect->y = y0;
+        rect->w = x1 - x0;
+        rect->h = y1 - y0;
+    } else if (rect) {
+        int right = FFMAX(rect->x + rect->w, x1);
+        int bottom = FFMAX(rect->y + rect->h, y1);
+        rect->x = FFMIN(rect->x, x0);
+        rect->y = FFMIN(rect->y, y0);
+        rect->w = right - rect->x;
+        rect->h = bottom - rect->y;
+    }
+}
+
+static void scan_lookup_bitmap(
+    const Bitmap *bitmap, ASS_Vector position, int offset_x, int offset_y,
+    const RenderContext *state, int *x0, int *y0, int *x1, int *y1)
+{
+    if (!bitmap || !bitmap->buffer)
+        return;
+    for (int y = 0; y < bitmap->h; y++) {
+        for (int x = 0; x < bitmap->w; x++) {
+            if (!bitmap->buffer[(ptrdiff_t) y * bitmap->stride + x])
+                continue;
+            int px = position.x + bitmap->left + x + offset_x;
+            int py = position.y + bitmap->top + y + offset_y;
+            if (px < state->clip_x0 || px >= state->clip_x1 ||
+                    py < state->clip_y0 || py >= state->clip_y1)
+                continue;
+            *x0 = FFMIN(*x0, px);
+            *y0 = FFMIN(*y0, py);
+            *x1 = FFMAX(*x1, px + 1);
+            *y1 = FFMAX(*y1, py + 1);
+        }
+    }
+}
+
+static void merge_lookup_rects(
+    ASS_IinatanLookupRect *target, int *target_count,
+    const ASS_IinatanLookupRect *source, int source_count)
+{
+    for (int i = 0; i < source_count; i++) {
+        const ASS_IinatanLookupRect *rect = &source[i];
+        update_lookup_rect(
+            target, target_count, rect->id, rect->x, rect->y,
+            rect->x + rect->w, rect->y + rect->h);
+    }
+}
